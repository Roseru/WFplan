{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wfplan-push",
  "main": "worker.js",
  "account_id": "2fa16f46adada03fcda1c61f0040544a",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "triggers": {"crons": ["* * * * *"]},
  "vars": {"APP_ORIGIN": "https://wfplan-wat.github.io", "VAPID_SUBJECT": "https://wfplan-wat.github.io", "SERVICE_URL": "https://wfplan-push.wfplan-push.workers.dev"},
  "d1_databases": [{"binding": "DB", "database_name": "wfplan-push", "database_id": "d181e672-2cf0-4f1f-b503-4e47a3fa49b7"}]
}
